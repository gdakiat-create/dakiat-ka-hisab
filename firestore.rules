rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMonthKey(key) {
      return key is string && key.size() == 7 && key.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredLanguage', 'currency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredLanguage', 'currency', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.preferredLanguage in ['both', 'roman_urdu', 'english']
        && data.currency in ['PKR', 'USD', 'GBP', 'AED', 'SAR']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonth(data, userId, monthId) {
      return data.keys().hasAll(['userId', 'monthKey', 'salary', 'budgetNote', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'salary', 'budgetNote', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidMonthKey(data.monthKey)
        && data.monthKey == monthId
        && (data.salary is int || data.salary is float)
        && data.salary >= 0
        && data.salary <= 100000000
        && data.budgetNote is string
        && data.budgetNote.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll(['userId', 'monthKey', 'title', 'amount', 'category', 'date', 'paymentMethod', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'title', 'amount', 'category', 'date', 'paymentMethod', 'note', 'groceryItemId', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidMonthKey(data.monthKey)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && (data.amount is int || data.amount is float)
        && data.amount > 0
        && data.amount <= 100000000
        && data.category in ['groceries', 'utilities', 'transport', 'dining', 'health', 'education', 'shopping', 'other']
        && isValidDateStr(data.date)
        && data.date[0:7] == data.monthKey
        && data.paymentMethod in ['cash', 'bank', 'wallet']
        && data.note is string
        && data.note.size() <= 250
        && (!('groceryItemId' in data) || (data.groceryItemId is string && data.groceryItemId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGrocery(data, userId) {
      return data.keys().hasAll(['userId', 'monthKey', 'name', 'unit', 'plannedQty', 'consumedQty', 'unitPrice', 'purchased', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'name', 'unit', 'plannedQty', 'consumedQty', 'unitPrice', 'purchased', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidMonthKey(data.monthKey)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.unit in ['kg', 'g', 'litre', 'ml', 'pack', 'dozen', 'piece']
        && (data.plannedQty is int || data.plannedQty is float)
        && data.plannedQty >= 0
        && data.plannedQty <= 100000
        && (data.consumedQty is int || data.consumedQty is float)
        && data.consumedQty >= 0
        && data.consumedQty <= 100000
        && (data.unitPrice is int || data.unitPrice is float)
        && data.unitPrice >= 0
        && data.unitPrice <= 10000000
        && data.purchased is bool
        && data.note is string
        && data.note.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'currency', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);

      match /months/{monthId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidMonthKey(monthId);
        allow list: if isSignedIn() && isVerified() && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidMonthKey(monthId)
          && isValidMonth(incoming(), userId, monthId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidMonthKey(monthId)
          && isValidMonth(incoming(), userId, monthId)
          && incoming().userId == existing().userId
          && incoming().monthKey == existing().monthKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['salary', 'budgetNote', 'updatedAt']);
        allow delete: if isSignedIn() && isVerified() && isOwner(userId) && isValidId(userId) && isValidMonthKey(monthId);
      }

      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(expenseId);
        allow list: if isSignedIn() && isVerified() && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(expenseId)
          && isValidExpense(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['monthKey', 'title', 'amount', 'category', 'date', 'paymentMethod', 'note', 'groceryItemId', 'updatedAt']);
        allow delete: if isSignedIn() && isVerified() && isOwner(userId) && isValidId(userId) && isValidId(expenseId);
      }

      match /groceries/{groceryId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(groceryId);
        allow list: if isSignedIn() && isVerified() && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(groceryId)
          && isValidGrocery(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(groceryId)
          && isValidGrocery(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().monthKey == existing().monthKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'unit', 'plannedQty', 'consumedQty', 'unitPrice', 'purchased', 'note', 'updatedAt']);
        allow delete: if isSignedIn() && isVerified() && isOwner(userId) && isValidId(userId) && isValidId(groceryId);
      }
    }
  }
}
